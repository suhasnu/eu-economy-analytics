{
  "name": "EU Economy",
  "dataColors": [
    "#0072B2",
    "#D55E00",
    "#009E73",
    "#7B52AB",
    "#E69F00",
    "#56B4E9",
    "#B23A6F",
    "#3F6F52"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2733",
  "tableAccent": "#0072B2",
  "good": "#009E73",
  "neutral": "#6B7785",
  "bad": "#C0392B",
  "maximum": "#0072B2",
  "center": "#C9D3DC",
  "minimum": "#F2F5F7",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 34,
      "color": "#1B2733"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 15,
      "color": "#0072B2"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0072B2"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#4A5568"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6E9EC" } },
            "radius": 6
          }
        ],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": false }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0072B2" } },
            "fontSize": 15,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left",
            "background": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "gridlineShow": false,
            "labelColor": { "solid": { "color": "#4A5568" } },
            "fontSize": 11,
            "showAxisTitle": false,
            "lineColor": { "solid": { "color": "#D7DCE1" } }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#EDF0F3" } },
            "gridlineThickness": 1,
            "gridlineStyle": "solid",
            "labelColor": { "solid": { "color": "#4A5568" } },
            "fontSize": 11,
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#1B2733" } },
            "fontSize": 11
          }
        ],
        "labels": [
          {
            "show": false,
            "color": { "solid": { "color": "#4A5568" } },
            "fontSize": 10
          }
        ]
      },
      "lineChart": {
        "lineStyles": [{ "strokeWidth": 2, "lineStyle": "solid" }]
      },
      "slicer": {
        "header": [
          {
            "show": false,
            "fontColor": { "solid": { "color": "#0072B2" } },
            "fontSize": 12
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#1B2733" } },
            "fontSize": 11
          }
        ]
      },
      "tableEx": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#0072B2" } },
            "fontSize": 11,
            "bold": true,
            "alignment": "Left"
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#1B2733" } },
            "backColor": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F3F7FA" } },
            "fontSize": 11
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E6E9EC" } },
            "rowPadding": 5
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F6F7F9" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F6F7F9" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
