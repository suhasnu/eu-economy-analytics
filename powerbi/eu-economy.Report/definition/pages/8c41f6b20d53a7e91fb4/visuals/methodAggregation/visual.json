  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why one number at a time",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0072B2",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Rates, index levels and survey balances share one column",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  They cannot be added, and most cannot be averaged",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  An unemployment rate is a share of each country's own labour force, so an average would weight Poland like Germany",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  The base measure returns a value only for a single series",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Blank means the question was ambiguous, not missing data",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}