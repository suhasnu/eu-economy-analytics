        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why one number at a time",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#0072B2",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rates, index levels and survey balances share one column. They cannot be added, and most cannot be averaged: an unemployment rate is a share of each country's own labour force, so an average would weight Poland like Germany.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The base measure returns a value only when exactly one series is in scope.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A blank means the question was ambiguous, not that data is missing.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
