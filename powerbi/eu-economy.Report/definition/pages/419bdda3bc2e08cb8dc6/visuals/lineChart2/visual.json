{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "lineChart2",
  "position": {
    "x": 272,
    "y": 100,
    "z": 40,
    "height": 320,
    "width": 992,
    "tabOrder": 400
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_start_date"
                }
              },
              "queryRef": "dim_date.month_start_date",
              "nativeQueryRef": "month_start_date",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_series"
                    }
                  },
                  "Property": "breakdown_label"
                }
              },
              "queryRef": "dim_series.breakdown_label",
              "nativeQueryRef": "breakdown_label"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Value"
                }
              },
              "queryRef": "_Measures.Value",
              "nativeQueryRef": "Value"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Components over time'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}