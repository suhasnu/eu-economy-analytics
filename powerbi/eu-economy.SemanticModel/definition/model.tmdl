model Model
	culture: de-DE
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_geo","dim_series","fct_observation"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table dim_date
ref table dim_geo
ref table dim_series
ref table fct_observation
ref table _Measures
ref table Parameter

ref cultureInfo de-DE

