table _Measures
	lineageTag: 772c9862-ff0a-40e0-b7bf-64796b3e2a37

	/// Observation value when exactly one fact row is in scope, otherwise blank.
	measure Value =
			IF (
			    COUNTROWS ( fct_observation ) = 1,
			    SELECTEDVALUE ( fct_observation[value] )
			)
		formatString: #,0.0
		lineageTag: f48beb88-3bbb-47ac-b59d-5e2e1161641e

	/// Value for the same period one year earlier.
	measure 'Value PY' =
			CALCULATE (
			    [Value],
			    SAMEPERIODLASTYEAR ( dim_date[full_date] )
			)
		formatString: #,0.0
		lineageTag: 34a2c078-69a0-49d3-8f85-e8409b05fe6f

	/// Most recent date holding an observation, ignoring any date filter.
	measure 'Latest Date' =
			CALCULATE (
			    MAXX (
			        FILTER ( fct_observation, NOT ISBLANK ( fct_observation[value] ) ),
			        RELATED ( dim_date[full_date] )
			    ),
			    REMOVEFILTERS ( dim_date )
			)
		lineageTag: b92033ea-51be-46c9-ab97-2a7e23160b7e

	/// Value at the latest month that has data.
	measure 'Latest Value' =
			VAR LatestDate = [Latest Date]
			RETURN
			    CALCULATE ( [Value], REMOVEFILTERS ( dim_date ), dim_date[full_date] = LatestDate )
		formatString: #,0.0
		lineageTag: 9eb58255-f92c-4bfe-a3db-360ad0781e13

	/// The latest month as text, for example Sep 2026.
	measure 'Latest Month' =
			VAR LatestDate = [Latest Date]
			RETURN
			    IF ( NOT ISBLANK ( LatestDate ), FORMAT ( LatestDate, "MMM yyyy", "en-US" ) )
		lineageTag: a0c4f536-8d03-4cf4-bfd6-a358f9bec292

	/// Change on a year earlier: percent for index series, points for rates.
	measure 'Latest Change' =
			VAR LatestDate = [Latest Date]
			VAR ValueNow = [Latest Value]
			VAR ValueThen =
			    CALCULATE ( [Value], REMOVEFILTERS ( dim_date ), dim_date[full_date] = EDATE ( LatestDate, -12 ) )
			VAR IsIndex = SELECTEDVALUE ( dim_series[unit_code] ) = "I21"
			RETURN
			    IF (
			        NOT ISBLANK ( ValueNow ) && NOT ISBLANK ( ValueThen ),
			        IF ( IsIndex, ( DIVIDE ( ValueNow, ValueThen ) - 1 ) * 100, ValueNow - ValueThen )
			    )
		lineageTag: 01d82b26-f8b5-4756-ad3d-0221d541d251

	/// Signed change with its unit, for the cards.
	measure 'Latest Change Label' =
			VAR Chg = [Latest Change]
			VAR IsIndex = SELECTEDVALUE ( dim_series[unit_code] ) = "I21"
			RETURN
			    IF (
			        NOT ISBLANK ( Chg ),
			        FORMAT ( Chg, "+0.0;-0.0;0.0", "en-US" )
			            & IF ( IsIndex, "% vs a year earlier", " pp vs a year earlier" )
			    )
		lineageTag: e67dd78b-f51c-4564-9a43-2b49e8600ee1

	/// Year on year change in the current filter context, unit aware.
	measure 'Change vs PY' =
			VAR ValueNow = [Value]
			VAR ValuePY = [Value PY]
			VAR IsIndex = SELECTEDVALUE ( dim_series[unit_code] ) = "I21"
			RETURN
			    IF (
			        NOT ISBLANK ( ValueNow ) && NOT ISBLANK ( ValuePY ),
			        IF ( IsIndex, ( DIVIDE ( ValueNow, ValuePY ) - 1 ) * 100, ValueNow - ValuePY )
			    )
		lineageTag: 13da94ef-73af-436d-a78c-a1ada64748b1

	/// Signed change with its unit only, no trailing phrase.
	measure 'Latest Change Short' =
			VAR Chg = [Latest Change]
			VAR IsIndex = SELECTEDVALUE ( dim_series[unit_code] ) = "I21"
			RETURN
			    IF (
			        NOT ISBLANK ( Chg ),
			        FORMAT ( Chg, "+0.0;-0.0;0.0", "en-US" )
			            & IF ( IsIndex, "%", " pp" )
			    )
		lineageTag: b8adc8a8-d105-4659-996f-01bc1a83714a

	/// Regional observation value when exactly one fact row is in scope, otherwise blank.
	measure 'Regional Value' =
			IF (
			    COUNTROWS ( fct_regional_observation ) = 1,
			    SELECTEDVALUE ( fct_regional_observation[value] )
			)
		lineageTag: 68cf91b9-ca4f-4698-858d-d6fce7d761cb

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( dim_regional_series[unit_code] ),
				    "Anzahl", "#,##0",
				    "Prozent", "0.0",
				    "#,0.0"
				)

	/// Most recent year holding a regional value in any region, ignoring date and region filters, so a visual shows one year.
	measure 'Regional Latest Year' =
			CALCULATE (
			    MAXX (
			        FILTER ( fct_regional_observation, NOT ISBLANK ( fct_regional_observation[value] ) ),
			        RELATED ( dim_date[year] )
			    ),
			    REMOVEFILTERS ( dim_date ),
			    REMOVEFILTERS ( dim_region )
			)
		formatString: 0
		lineageTag: 6dfe2d60-8fce-4fd3-aeae-0f43ad9ddfa2

	/// Regional value at the latest year that has data.
	measure 'Regional Latest Value' =
			VAR LatestYear = [Regional Latest Year]
			RETURN
			    CALCULATE ( [Regional Value], REMOVEFILTERS ( dim_date ), dim_date[year] = LatestYear )
		lineageTag: dd1d39f4-4017-4799-9801-a28cb3b09f3b

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( dim_regional_series[unit_code] ),
				    "Anzahl", "#,##0",
				    "Prozent", "0.0",
				    "#,0.0"
				)

	/// Change on the previous year: points for Prozent series, percent for Anzahl series (blank if the earlier count is zero).
	measure 'Regional Change vs PY' =
			VAR SelectedYear = SELECTEDVALUE ( dim_date[year] )
			VAR ValueNow = [Regional Value]
			VAR ValuePY =
			    CALCULATE ( [Regional Value], REMOVEFILTERS ( dim_date ), dim_date[year] = SelectedYear - 1 )
			VAR Unit = SELECTEDVALUE ( dim_regional_series[unit_code] )
			RETURN
			    IF (
			        NOT ISBLANK ( SelectedYear ) && NOT ISBLANK ( ValueNow ) && NOT ISBLANK ( ValuePY ),
			        SWITCH (
			            Unit,
			            "Prozent", ValueNow - ValuePY,
			            "Anzahl", DIVIDE ( ValueNow - ValuePY, ValuePY ) * 100
			        )
			    )
		lineageTag: 649c9963-f265-4f5d-99bf-cb5e8bd32bca

	/// Signed regional change with its unit only, for example +0.4 pp or -2.1%.
	measure 'Regional Change Label' =
			VAR Chg = [Regional Change vs PY]
			VAR IsCount = SELECTEDVALUE ( dim_regional_series[unit_code] ) = "Anzahl"
			RETURN
			    IF (
			        NOT ISBLANK ( Chg ),
			        FORMAT ( Chg, "+0.0;-0.0;0.0", "en-US" )
			            & IF ( IsCount, "%", " pp" )
			    )
		lineageTag: 5fe3e0e3-1d3a-456d-9b74-4b284c2bb897

	/// Why a regional value is missing, for the map tooltip. Blank when there is a value or several markers.
	measure 'Regional Status Note' =
			VAR Marker = SELECTEDVALUE ( fct_regional_observation[status] )
			RETURN
			    IF (
			        ISBLANK ( [Regional Value] ) && NOT ISBLANK ( Marker ),
			        SWITCH (
			            Marker,
			            "-", "District did not exist that year",
			            ".", "Value withheld or unknown",
			            "x", "Not shown: the figure would not be meaningful"
			        )
			    )
		lineageTag: 73fcfee0-29f5-4aed-8c67-5a06d262f04f

	column _
		isHidden
		lineageTag: abba6b1d-b759-4223-bff1-d89abe307e8e
		isNameInferred
		sourceColumn: [_]

	partition _Measures = calculated
		mode: import
		source = ROW("_", BLANK())

